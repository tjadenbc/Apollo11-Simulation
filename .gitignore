# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
.DS_Store
.ipynb_checkpoints/

# --- Monte Carlo output ---
# Exclude every run directory and stray artifact under outputs/ EXCEPT the
# single definitive run this release documents. New dev runs are ignored by
# default; add another `!outputs/<name>/` line to publish one.
outputs/*
!outputs/final/

# Within the published run keep the summary products (CSVs, nominal trajectory,
# targeting JSONs, dashboard, realism audit, figures) but exclude the bulky and
# derived artifacts: the per-trial debug JSONs (distributed as the release-asset
# tarball instead), the tarball itself, the review PDFs, the claude.ai artifact
# fragments, and the Artemis-hosted comparison copies.
outputs/final/trials/
outputs/final/apollo11_final_trials.tar.gz
outputs/final/*.pdf
outputs/final/*_artifact.html
outputs/final/*comparison*

# --- Generated documents ---
# Build artifacts of the manuscript; regenerate rather than track them.
TJADEN_2026_06_15.pdf
TJADEN_2026_06_15.docx
paper_render.html

# --- Submission staging ---
# Local working folder for assembling the JBIS submission; never tracked.
JBIS2026/

# --- Local dev assets (kept on disk, NOT part of the public release) ---
# Development tooling, diagnostics, the manuscript, and the internal project
# guide live here locally but are intentionally excluded from the release.
CLAUDE.md
paper.md
